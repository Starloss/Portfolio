{
    "env": {
        "IMPECCABLE_NO_TELEMETRY": "1",
        "IMPECCABLE_NO_UPDATE_CHECK": "1",
        "DO_NOT_TRACK": "1"
    },
    "permissions": {
        "allow": [
            "mcp__codegraph__*"
        ]
    },
    "hooks": {
        "SessionStart": [
            {
                "matcher": "startup",
                "hooks": [
                    {
                        "type": "command",
                        "command": "codegraph init >/dev/null 2>&1 || true"
                    }
                ]
            }
        ],
        "UserPromptSubmit": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "codegraph prompt-hook"
                    }
                ]
            }
        ]
    }
}
