{
    "permissions": {
        "allow": ["mcp__codegraph__*"]
    },
    "hooks": {
        "SessionStart": [
            {
                "matcher": "startup",
                "hooks": [
                    {
                        "type": "command",
                        "command": "codegraph init >/dev/null 2>&1 || true"
                    }
                ]
            }
        ],
        "UserPromptSubmit": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "codegraph.cmd prompt-hook"
                    }
                ]
            }
        ]
    }
}
