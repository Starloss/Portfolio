{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "isSinglePageApplication": true,
      "numberOfRuns": 3,
      "url": ["http://localhost/?escena=webgl&hora=22:00"],
      "settings": {
        "preset": "desktop",
        "chromeFlags": "--use-angle=swiftshader --enable-unsafe-swiftshader"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9, "aggregationMethod": "median-run" }],
        "categories:accessibility": ["error", { "minScore": 0.9, "aggregationMethod": "median-run" }],
        "errors-in-console": ["error", { "maxLength": 0, "aggregationMethod": "pessimistic" }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./.lighthouseci-desktop"
    }
  }
}
