diff -ruN --strip-trailing-cr orig/src/app/scene/prototype-boveda/lab.ts proto/src/app/scene/prototype-boveda/lab.ts
--- orig/src/app/scene/prototype-boveda/lab.ts	1969-12-31 20:00:00.000000000 -0400
+++ proto/src/app/scene/prototype-boveda/lab.ts	2026-10-31 02:43:41.764994500 -0400
@@ -0,0 +1,24 @@
+// EXPERIMENTO desechable (#75): qué probar, por la URL. Solo para el laboratorio de medición.
+const q = new URLSearchParams(window.location.search);
+
+export const LAB = {
+    /** raf: el prototipo tal cual. css: BovedaCss. */
+    mode: q.get('lab') === 'css' ? 'css' : 'raf',
+    /** Cuántas estrellas; sin esto, 420 (raf) y 120 (css). */
+    n: q.get('n') ? Number(q.get('n')) : null,
+    /** circles: un nodo por estrella. path: dos <path>. */
+    form: q.get('form') === 'path' ? ('path' as const) : ('circles' as const),
+    /** Cómo cambia de color el paisaje: fill 3,6 s, fill06 (0,6 s al centro), cross, none. */
+    land: q.get('land') ?? 'fill',
+    /** proto: background-color y opacity. css: dos capas y solo opacity. */
+    tint: q.get('tintm') === 'css' ? 'css' : 'proto',
+    nobar: q.get('nobar') === '1',
+};
+
+/** Regla que aplica la forma elegida de cambio de color del paisaje. */
+export function landRule(seconds: number) {
+    const land = '.scene [data-layer]:not([data-layer="sky"])';
+    if (LAB.land === 'fill') return `.scene * { transition-duration: ${seconds}s !important; }`;
+    if (LAB.land === 'fill06') return `${land} * { transition-delay: 1.5s !important; }`;
+    return `${land}, ${land} * { transition: none !important; }`;
+}
