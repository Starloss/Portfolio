+/* EXPERIMENTO desechable (#75): solo transform y opacity. */
+.scene .scene-sky-night {
+    transition: opacity 3.6s cubic-bezier(0.65, 0, 0.35, 1) !important;
+}
+
+.bc-sweep {
+    position: absolute;
+    left: 50%;
+    top: 115%;
+    width: 250vmax;
+    height: 250vmax;
+    opacity: 0;
+    transform: translate(-50%, -50%);
+    pointer-events: none;
+}
+.bc-sweep.to-night {
+    animation:
+        bc-sweep-night 3.6s cubic-bezier(0.65, 0, 0.35, 1) both,
+        bc-fade 3.6s linear both;
+}
+.bc-sweep.to-day {
+    animation:
+        bc-sweep-day 3.6s cubic-bezier(0.65, 0, 0.35, 1) both,
+        bc-fade 3.6s linear both;
+}
+@keyframes bc-sweep-night {
+    from {
+        transform: translate(-50%, -50%) rotate(0deg);
+    }
+    to {
+        transform: translate(-50%, -50%) rotate(-180deg);
+    }
+}
+@keyframes bc-sweep-day {
+    from {
+        transform: translate(-50%, -50%) rotate(-180deg);
+    }
+    to {
+        transform: translate(-50%, -50%) rotate(-360deg);
+    }
+}
+@keyframes bc-fade {
+    0%,
+    100% {
+        opacity: 0;
+    }
+    25.5%,
+    74.5% {
+        opacity: 1;
+    }
+}
+
+.bc-stars {
+    position: absolute;
+    left: 50%;
+    top: 115%;
+}
+.bc-stars.to-night {
+    animation: bc-stars-night 3.6s cubic-bezier(0.65, 0, 0.35, 1) both;
+}
+.bc-stars.to-day {
+    animation: bc-stars-day 3.6s cubic-bezier(0.65, 0, 0.35, 1) both;
+}
+@keyframes bc-stars-night {
+    from {
+        opacity: 0;
+        transform: rotate(var(--swing));
+    }
+    to {
+        opacity: 1;
+        transform: rotate(0);
+    }
+}
+@keyframes bc-stars-day {
+    from {
+        opacity: 1;
+        transform: rotate(0);
+    }
+    to {
+        opacity: 0;
+        transform: rotate(calc(var(--swing) * -1));
+    }
+}
+
+.bc-astro {
+    position: absolute;
+    top: 0;
+    left: 0;
+}
+
+/* El tinte de Clima con dos capas y solo opacity. */
+.bc-tint {
+    transition: opacity 3.6s ease;
+}
+
+@keyframes bc-land-in {
+    from {
+        opacity: 0;
+    }
+}
+.bc-land-in {
+    animation: bc-land-in 3.6s cubic-bezier(0.65, 0, 0.35, 1) both;
+}
diff -ruN --strip-trailing-cr orig/src/app/scene/prototype-boveda/BovedaCss.tsx proto/src/app/scene/prototype-boveda/BovedaCss.tsx
--- orig/src/app/scene/prototype-boveda/BovedaCss.tsx	1969-12-31 20:00:00.000000000 -0400
+++ proto/src/app/scene/prototype-boveda/BovedaCss.tsx	2026-10-31 02:43:26.971693000 -0400
@@ -0,0 +1,188 @@
+// EXPERIMENTO desechable (#75): la Bóveda celeste variante C solo con transform y opacity.
+// El giro, las estrellas y el cielo de Noche son @keyframes/transition; el sol y la luna usan WAAPI
+// porque su arco depende de la hora: las dos vías corren en el compositor. Sin rAF.
+import React, { useLayoutEffect, useRef, useState } from 'react';
+
+import { DAY, NIGHT } from '../palette';
+
+import { arcPoint, restOf, type BovedaParams } from './sim';
+import './boveda-css.css';
+
+const SECONDS = 3.6;
+const SWING = 0.9;
+const RISE_F = -0.12;
+const SET_F = 1.12;
+const STEPS = 16;
+// Lo más lejos que llega un punto de la pantalla desde el pivote en 390×844 es ~990 px, y el campo
+// solo gira ±0,9 rad: fuera de este sector una estrella nunca se ve.
+const RADIUS = 1050;
+const SECTOR = 1.15;
+
+const ease = (t: number) => t * t * t * (t * (6 * t - 15) + 10);
+const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
+
+function starsOf(count: number) {
+    return Array.from({ length: count }, (_, i) => {
+        const a = -SECTOR + 2 * SECTOR * ((i * 0.618034) % 1) - Math.PI / 2;
+        const r = 40 + Math.sqrt((i + 0.5) / count) * RADIUS;
+        return { x: Math.cos(a) * r, y: Math.sin(a) * r, s: i % 7 ? 0.9 : 1.6 };
+    });
+}
+
+function moonPath(phase: number) {
+    const waxing = phase <= 0.5;
+    const k = waxing ? phase : 1 - phase;
+    const rx = Math.abs(Math.cos(2 * Math.PI * k));
+    const sweep = k < 0.25 ? 0 : 1;
+    return {
+        d: `M0 -1 A1 1 0 0 1 0 1 A${rx.toFixed(3)} 1 0 0 ${sweep} 0 -1Z`,
+        flip: waxing ? 1 : -1,
+    };
+}
+
+function arcFrames(
+    from: number,
+    to: number,
+    alpha: number,
+    size: number,
+    w: number,
+    h: number,
+    p: BovedaParams,
+) {
+    return Array.from({ length: STEPS + 1 }, (_, i) => {
+        const { x, y } = arcPoint(lerp(from, to, ease(i / STEPS)), p);
+        return {
+            transform: `translate(${(x * w - size / 2).toFixed(1)}px, ${(y * h - size / 2).toFixed(1)}px)`,
+            opacity: alpha,
+        };
+    });
+}
+
+export const BovedaCss: React.FC<{
+    night: boolean;
+    params: BovedaParams;
+    count: number;
+    form?: 'circles' | 'path';
+}> = ({ night, params, count, form = 'circles' }) => {
+    const box = useRef<HTMLDivElement>(null);
+    const sun = useRef<HTMLDivElement>(null);
+    const moon = useRef<SVGSVGElement>(null);
+    const [turn, setTurn] = useState<{ night: boolean; n: number } | null>(null);
+    const [lastNight, setLastNight] = useState(night);
+    if (lastNight !== night) {
+        setLastNight(night);
+        setTurn({ night, n: (turn?.n ?? 0) + 1 });
+    }
+    const stars = useRef<ReturnType<typeof starsOf> | null>(null);
+    if (!stars.current) stars.current = starsOf(count);
+
+    const rest = restOf(params);
+    useLayoutEffect(() => {
+        if (!turn) return;
+        const root = box.current!.parentElement!;
+        const { clientWidth: w, clientHeight: h } = root;
+        const options = { duration: SECONDS * 1000, easing: 'linear' };
+        const sunFrames = turn.night
+            ? arcFrames(rest.sun.f, SET_F, rest.sun.alpha, 120, w, h, params)
+            : arcFrames(RISE_F, rest.sun.f, rest.sun.alpha, 120, w, h, params);
+        const moonFrames = turn.night
+            ? arcFrames(RISE_F, rest.moon.f, rest.moon.alpha, 52, w, h, params)
+            : arcFrames(rest.moon.f, SET_F, rest.moon.alpha, 52, w, h, params);
+        const animations = [
+            sun.current!.animate(sunFrames, options),
+            moon.current!.animate(moonFrames, options),
+        ];
+        return () => animations.forEach((a) => a.cancel());
+        // Solo arranca al cambiar de tema.
+        // eslint-disable-next-line react-hooks/exhaustive-deps
+    }, [turn]);
+
+    const place = (f: number, size: number, alpha: number, shown: boolean, w: number, h: number) => {
+        const { x, y } = arcPoint(f, params);
+        return {
+            transform: `translate(${x * w - size / 2}px, ${y * h - size / 2}px)`,
+            opacity: shown ? alpha : 0,
+        };
+    };
+    const w = box.current?.parentElement?.clientWidth ?? window.innerWidth;
+    const h = box.current?.parentElement?.clientHeight ?? window.innerHeight;
+    const { d, flip } = moonPath(params.phase);
+    const dir = turn ? (turn.night ? 'to-night' : 'to-day') : '';
+    const list = stars.current;
+
+    return (
+        <div ref={box} data-part="boveda-css" className="scene-layer">
+            <div
+                key={`sweep${turn?.n ?? 0}`}
+                className={`bc-sweep ${dir}`}
+                onAnimationEnd={(e) => {
+                    if (e.animationName.startsWith('bc-sweep')) setTurn(null);
+                }}
+                style={{
+                    background: `linear-gradient(to bottom, ${DAY.skyBottom} 42.8%, #ffcf9a 46.6%, #f28a5a 50%, #4a2f66 52.9%, ${NIGHT.skyTop} 57.2%)`,
+                }}
+            />
+            <div
+                key={`stars${turn?.n ?? 0}`}
+                className={`bc-stars ${dir}`}
+                style={{ opacity: night ? 1 : 0, '--swing': `${SWING}rad` } as React.CSSProperties}
+            >
+                <svg width="4" height="4" style={{ overflow: 'visible', display: 'block' }} aria-hidden="true">
+                    {form === 'path' ? (
+                        <>
+                            <path
+                                d={list.filter((s) => s.s < 1).map((s) => `M${s.x.toFixed(0)} ${s.y.toFixed(0)}h0`).join('')}
+                                stroke="#fff"
+                                strokeWidth="1.8"
+                                strokeLinecap="round"
+                            />
+                            <path
+                                d={list.filter((s) => s.s > 1).map((s) => `M${s.x.toFixed(0)} ${s.y.toFixed(0)}h0`).join('')}
+                                stroke="#fff"
+                                strokeWidth="3.2"
+                                strokeLinecap="round"
+                            />
+                        </>
+                    ) : (
+                        list.map((s) => <circle key={`${s.x}|${s.y}`} cx={s.x} cy={s.y} r={s.s} fill="#fff" />)
+                    )}
+                </svg>
+            </div>
+            <div
+                ref={sun}
+                className="bc-astro"
+                style={{
+                    ...place(rest.sun.f, 120, rest.sun.alpha, !night, w, h),
+                    width: 120,
+                    height: 120,
+                    borderRadius: '50%',
+                    background:
+                        'radial-gradient(closest-side, #fff8e0 0 26%, rgba(255,225,150,.55) 30%, rgba(255,205,120,.16) 60%, transparent)',
+                }}
+            />
+            <svg
+                ref={moon}
+                className="bc-astro"
+                viewBox="-1.1 -1.1 2.2 2.2"
+                aria-hidden="true"
+                style={{
+                    ...place(rest.moon.f, 52, rest.moon.alpha, night, w, h),
+                    right: 'auto',
+                    bottom: 'auto',
+                    width: 52,
+                    height: 52,
+                    overflow: 'visible',
+                }}
+            >
+                <g transform={`rotate(-35) scale(${flip} 1)`}>
+                    <circle r="1" fill="#fff" opacity="0.07" />
+                    <path
+                        d={d}
+                        fill="#f4eccb"
+                        style={{ filter: 'drop-shadow(0 0 .22px rgba(255,241,196,.7))' }}
+                    />
+                </g>
+            </svg>
+        </div>
+    );
+};
